# Line endings: Linux scripts must be LF, Windows batch files CRLF, whatever system checks them out.
* text=auto
*.sh  text eol=lf
*.py  text eol=lf
*.desktop text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.iss text eol=crlf
*.png binary
*.ico binary
*.docx binary
*.zip binary
*.gz binary
*.pdf binary
